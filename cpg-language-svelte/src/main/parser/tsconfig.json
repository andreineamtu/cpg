{
  "compilerOptions": {
    "target": "ES2016", 
    "module": "CommonJS", 
    "outDir": "../../../../build/parser/src",
    "rootDir": "./src", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*.ts" 
  ],
  "exclude": [
    "node_modules"
  ]
} 